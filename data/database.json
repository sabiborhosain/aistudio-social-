  "posts": [
    {
      "id": 1,
      "user_id": 1,
      "page_id": null,
      "post_type": "MIXED",
      "privacy": "PUBLIC",
      "content": "Welcome to DevSphere! We are thrilled to launch this complete, production-ready developer social platform. Here is how our block-based post architecture cleanly separates code execution, formatting, and responsive viewing:",
      "location_name": "DevSphere HQ, Silicon Valley",
      "feeling_emoji": "🚀",
      "feeling_text": "excited",
      "reactions_count": 42,
      "comments_count": 6,
      "shares_count": 14,
      "views_count": 240,
      "is_pinned": 1,
      "is_deleted": 0,
      "created_at": "2026-09-26T11:53:55.613Z",
      "updated_at": "2026-09-26T11:53:55.613Z"
    },
    {
      "id": 2,
      "user_id": 2,
      "page_id": null,
      "post_type": "CODE",
      "privacy": "PUBLIC",
      "content": "Check out this clean TypeScript utility for verifying RSA-signed JWT payloads with fallback token rotation. What do you think about this pattern?",
      "location_name": "Austin Tech District",
      "feeling_emoji": "💡",
      "feeling_text": "thoughtful",
      "reactions_count": 19,
      "comments_count": 3,
      "shares_count": 5,
      "views_count": 180,
      "is_pinned": 0,
      "is_deleted": 0,
      "created_at": "2026-09-26T12:53:55.613Z",
      "updated_at": "2026-09-26T12:53:55.613Z"
    }
  ],
  "post_blocks": [
    {
      "id": 1,
      "post_id": 1,
      "block_order": 0,
      "block_type": "TEXT",
      "content": "DevSphere empowers developers and engineers to share rich multimedia thoughts, interactive code snippets with syntax highlighting, and architecture deep dives.",
      "meta_json": null
    },
    {
      "id": 2,
      "post_id": 1,
      "block_order": 1,
      "block_type": "CODE",
      "content": "/**\n * Enterprise Resilient Database Connection Pool\n * Supports seamless MySQL connection with automatic failover fallback\n */\nimport mysql from \"mysql2/promise\";\n\nexport async function createConnectionPool() {\n  return mysql.createPool({\n    host: process.env.DB_HOST || \"localhost\",\n    user: process.env.DB_USER || \"root\",\n    password: process.env.DB_PASSWORD || \"\",\n    database: process.env.DB_NAME || \"devsphere_db\",\n    waitForConnections: true,\n    connectionLimit: 20,\n    queueLimit: 0\n  });\n}",
      "meta_json": {
        "language": "typescript",
        "title": "db-pool.ts"
      }
    },
    {
      "id": 3,
      "post_id": 1,
      "block_order": 2,
      "block_type": "TEXT",
      "content": "Every code block supports one-click copying, line numbering, and syntax highlighting for 20+ languages including TypeScript, Python, Go, and SQL.",
      "meta_json": null
    },
    {
      "id": 4,
      "post_id": 2,
      "block_order": 0,
      "block_type": "TEXT",
      "content": "Here is the token validation function with strict payload parsing:",
      "meta_json": null
    },
    {
      "id": 5,
      "post_id": 2,
      "block_order": 1,
      "block_type": "CODE",
      "content": "import jwt from \"jsonwebtoken\";\n\ninterface TokenPayload {\n  userId: number;\n  email: string;\n  role: \"USER\" | \"ADMIN\" | \"SUPER_ADMIN\";\n}\n\nexport function verifyUserToken(token: string): TokenPayload | null {\n  try {\n    return jwt.verify(token, process.env.JWT_SECRET!) as TokenPayload;\n  } catch (err) {\n    return null;\n  }\n}",
      "meta_json": {
        "language": "typescript",
        "title": "verifyToken.ts"
      }
    }
  ],
