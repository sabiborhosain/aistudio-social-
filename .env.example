# ==============================================================================
# DevSphere Social Platform - Environment Configuration
# ==============================================================================
# Development Preview Mode:
# In development preview mode, all database, Cloudflare R2 storage, and SMTP
# services run automatically with zero external dependencies (using local
# resilient storage and in-memory mock dispatcher).
# Only JWT_SECRET has a safe development fallback configured for preview.
#
# NOTE ON CLOUDFLARE R2 & SMTP:
# Cloudflare R2 and SMTP are NOT configured via environment variables.
# They are managed directly and securely inside the Admin Panel:
# - Admin Panel -> Settings -> Storage / Cloudflare R2
# - Admin Panel -> Settings -> Email / SMTP
# Sensitive credentials are encrypted at rest with AES-256-GCM in the database.
# ==============================================================================

# 1. Authentication (JWT credentials remain backend environment variables)
JWT_SECRET=devsphere_jwt_development_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 2. MySQL Database Configuration (Credentials remain backend environment variables)
# When provided in production or local development, DevSphere connects directly to MySQL 8.0+
# (database/database.sql provides full schema compatible with phpMyAdmin).
# If unconfigured in preview, the app runs gracefully using local resilient storage.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
